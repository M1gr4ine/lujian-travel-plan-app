<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lujian" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/coral</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
    </style>

    <style name="Theme.Lujian.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Lujian</item>
    </style>
</resources>
